# Copy to .env (or run "npm run setup" in the repository root). Never commit .env.

# Port of the main web app
PORT=3000

# Base URL of the rides microservice
RIDES_SERVICE_URL=http://localhost:4000/api/v1

# Max time (ms) to wait for the microservice
RIDES_SERVICE_TIMEOUT_MS=8000

# Set to true when serving over HTTPS so the session cookie is only sent over HTTPS
COOKIE_SECURE=false

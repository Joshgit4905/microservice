# Copy this file to .env (or run "npm run setup" in the repository root, which also generates JWT_SECRET).
# Never commit the real .env file.

# Port of the microservice
PORT=4000

# Secret used to sign JWTs (HS256). At least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-at-least-32-random-characters

# Lifetime of the access token (e.g. 15m, 1h)
JWT_EXPIRES_IN=15m

# Origin allowed by CORS (the main web app)
CORS_ORIGIN=http://localhost:3000

# Third-party API: Open-Meteo forecast (free, no API key needed)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_MS=4000

# Max login attempts per IP every 15 minutes
LOGIN_RATE_LIMIT=10
